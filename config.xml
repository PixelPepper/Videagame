<?xml version='1.0' encoding='utf-8'?>
<widget id="com.dungeonsurvior.game" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Dungeon Survivor</name>
    <description>
        A roguelike dungeon survival game where you fight monsters and upgrade your character
    </description>
    <author email="dev@dungeonsurvior.com" href="https://dungeonsurvior.com">
        Dungeon Survivor Team
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    
    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="33" />
        <preference name="Orientation" value="landscape" />
        <preference name="Fullscreen" value="true" />
    </platform>
    
    <preference name="Orientation" value="landscape" />
    <preference name="Fullscreen" value="true" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xff1a1a1a" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#000000" />
    <preference name="StatusBarStyle" value="blackopaque" />
    
    <icon src="icon.png" />
</widget>
